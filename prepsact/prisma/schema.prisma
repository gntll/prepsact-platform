generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SectionType {
  MATH
  READING_WRITING
}

enum DifficultyTier {
  EASY
  MEDIUM
  HARD
}

model Question {
  id            String         @id @default(cuid())
  section       SectionType
  domain        String         // e.g., "Algebra", "Advanced Math", "Craft and Structure"
  difficulty    DifficultyTier @default(MEDIUM)
  prompt        String         // The question prompt text (can include LaTeX/Markdown)
  passage       String?        // Optional passage for reading questions
  explanation   String?        // Detailed step-by-step solution
  choices       Choice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Choice {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String   // e.g., "A", "B", "C", "D"
  text        String   // Option content
  isCorrect   Boolean  @default(false)
}
